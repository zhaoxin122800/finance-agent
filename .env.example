# ===== LLM 配置（OpenAI 兼容）=====
# 默认填 GLM（智谱），也可换 DeepSeek / 通义 / OpenAI
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash

# ===== 数据源 =====
# free=复用 vendors/data.py（新浪/搜狐）；paid=预留，将来接 Tushare/同花顺
DATA_SOURCE=free

# ===== 缓存 =====
# 实时行情缓存有效期（秒）
CACHE_TTL_REALTIME=30

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
